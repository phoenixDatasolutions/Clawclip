# ═══════════════════════════════════════════════════════════════
# ClawClip Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# The setup wizard (clawclip setup) will do this for you.

# ── General ─────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────
# DATABASE_URL=sqlite+aiosqlite:///clawclip.db

# ── Telegram ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=

# ── Discord ─────────────────────────────────────────────────────
# DISCORD_BOT_TOKEN=

# ── Slack ───────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_SIGNING_SECRET=

# ── WhatsApp ────────────────────────────────────────────────────
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ── LLM Providers ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ── Dashboard ──────────────────────────────────────────────────
DASHBOARD_JWT_SECRET=change-me-in-production
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=

# ── Security ────────────────────────────────────────────────────
# VAULT_ENCRYPTION_KEY=

# ── Cache / Redis ────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── Vector Store: Pinecone ───────────────────────────────────────
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=gcp-starter

# ── Vector Store: Weaviate ───────────────────────────────────────
# WEAVIATE_URL=http://localhost:8080

# ── Features ────────────────────────────────────────────────────
# TAVILY_API_KEY=
# GITHUB_TOKEN=
# WEBHOOK_SECRET=
# CHROMADB_URL=http://localhost:8000
